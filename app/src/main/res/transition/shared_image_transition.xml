<?xml version="1.0" encoding="utf-8"?>
<!-- Smooth shared element transition for image transformations -->
<transitionSet xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="350"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:transitionOrdering="together">
    
    <!-- Change image bounds smoothly -->
    <changeBounds />
    
    <!-- Transform image shape (rounded corners, etc.) -->
    <changeTransform />
    
    <!-- Fade image smoothly during transition -->
    <changeImageTransform />
    
    <!-- Clip image bounds during animation -->
    <changeClipBounds />
    
</transitionSet>
