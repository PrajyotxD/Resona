<?xml version="1.0" encoding="utf-8"?>
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    
    <item android:duration="3000">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0C0C14"
                android:centerColor="#14141E"
                android:endColor="#1A1A28"
                android:type="linear" />
        </shape>
    </item>
    
    <item android:duration="3000">
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:startColor="#14141E"
                android:centerColor="#1A1A28"
                android:endColor="#0C0C14"
                android:type="linear" />
        </shape>
    </item>
    
    <item android:duration="3000">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#1A1A28"
                android:centerColor="#0C0C14"
                android:endColor="#14141E"
                android:type="linear" />
        </shape>
    </item>
    
    <item android:duration="3000">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#0C0C14"
                android:centerColor="#14141E"
                android:endColor="#1A1A28"
                android:type="linear" />
        </shape>
    </item>
    
</animation-list>
