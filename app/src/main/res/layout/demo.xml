<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D110D"> <View
    android:layout_width="400dp"
    android:layout_height="400dp"
    android:layout_gravity="top|start"
    android:layout_marginTop="-120dp"
    android:layout_marginStart="-100dp"
    android:background="@drawable/gradient"
    android:alpha="0.9" />

    <View
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-150dp"
        android:layout_marginEnd="-150dp"
        android:background="@drawable/gradient"
        android:rotation="180"
        android:alpha="0.7" />

    <ImageView
        android:id="@+id/noise_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.08"
        tools:background="#11FFFFFF" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to Resona"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Experience the soundscape."
            android:textColor="#A0BDA0"
            android:textSize="18sp"
            android:lineSpacingExtra="4dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="48dp"
            android:text="Get Started"
            android:backgroundTint="#4A6836"
            android:textColor="#FFF"
            android:textStyle="bold"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:text="Log In"
            android:backgroundTint="#1A2518"
            android:textColor="#A0BDA0"
            style="?android:attr/borderlessButtonStyle"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>