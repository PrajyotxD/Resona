<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0C14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

    <!-- Header Skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <!-- Profile Avatar Skeleton -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/skeleton_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Greeting Skeleton -->
            <View
                android:layout_width="80dp"
                android:layout_height="12dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/skeleton_rect" />

            <!-- Username Skeleton -->
            <View
                android:layout_width="120dp"
                android:layout_height="20dp"
                android:background="@drawable/skeleton_rect" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category Label Skeleton -->
    <View
        android:layout_width="140dp"
        android:layout_height="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/skeleton_rect" />

    <!-- Chips Skeleton -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <View
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/skeleton_chip" />

        <View
            android:layout_width="85dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/skeleton_chip" />

        <View
            android:layout_width="75dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/skeleton_chip" />

        <View
            android:layout_width="90dp"
            android:layout_height="32dp"
            android:background="@drawable/skeleton_chip" />
    </LinearLayout>

    <!-- Section 1 -->
    <include layout="@layout/skeleton_home_section" />

    <!-- Section 2 -->
    <include
        layout="@layout/skeleton_home_section"
        android:layout_marginTop="20dp" />

    <!-- Section 3 -->
    <include
        layout="@layout/skeleton_home_section"
        android:layout_marginTop="20dp" />

</LinearLayout>

    <!-- Shimmer Overlay -->
    <View
        android:id="@+id/shimmer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/skeleton_shimmer"
        android:alpha="0.3" />

</FrameLayout>
