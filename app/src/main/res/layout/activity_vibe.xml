<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#121212"
    tools:context=".activity.Vibe">

    <!-- Gradient Background View -->
    <View
        android:id="@+id/gradient_background"
        android:layout_width="match_parent"
        android:layout_height="500dp" />

    <!-- Main ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header Content -->
            <LinearLayout
                android:id="@+id/header_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Top Bar with Back and Search -->
                <RelativeLayout
                    android:id="@+id/top_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentStart="true"
                        android:padding="10dp"
                        android:src="@drawable/back"
                        android:tint="#FFFFFF"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <ImageView
                        android:id="@+id/btn_search"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:padding="10dp"
                        android:src="@android:drawable/ic_menu_search"
                        android:tint="#FFFFFF"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </RelativeLayout>

                <!-- Search Bar -->
                <RelativeLayout
                    android:id="@+id/search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/btn_close_search"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentStart="true"
                        android:padding="10dp"
                        android:src="@drawable/back"
                        android:tint="#FFFFFF"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_toStartOf="@+id/btn_clear_search"
                        android:layout_toEndOf="@+id/btn_close_search"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:hint="Search in playlist"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:textSize="16sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:maxLines="1" />

                    <ImageView
                        android:id="@+id/btn_clear_search"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:tint="#FFFFFF"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:visibility="gone" />

                </RelativeLayout>

                <!-- Album Artwork -->
                <ImageView
                    android:id="@+id/album_artwork"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/plugin" />

                <!-- Title -->
                <TextView
                    android:id="@+id/playlist_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="song"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="normal" />

                <!-- Creator Info -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:id="@+id/creator_avatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/plugin"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/creator_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Creator"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Metadata -->
                <TextView
                    android:id="@+id/playlist_metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:text="Loading..."
                    android:textColor="#B3B3B3"
                    android:textSize="12sp" />

                <!-- Action Buttons Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Download with GlassView -->
                    <dev.ui.obscura.blur.GlassView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_halo"
                        android:elevation="6dp"
                        android:padding="4dp"
                        app:obscura_blurRadius="28"
                        app:obscura_cornerRadius="360dp"
                        app:obscura_opacity="0.65"
                        app:obscura_overlayColor="#12FFFFFF">

                        <ImageView
                            android:id="@+id/btn_download"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:src="@drawable/download"
                            android:tint="#FFFFFF"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                    </dev.ui.obscura.blur.GlassView>

                    <!-- Edit with GlassView -->
                    <dev.ui.obscura.blur.GlassView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_glass_halo"
                        android:elevation="6dp"
                        android:padding="4dp"
                        app:obscura_blurRadius="28"
                        app:obscura_cornerRadius="360dp"
                        app:obscura_opacity="0.65"
                        app:obscura_overlayColor="#12FFFFFF">

                        <ImageView
                            android:id="@+id/btn_edit"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:src="@drawable/edit"
                            android:tint="#FFFFFF"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                    </dev.ui.obscura.blur.GlassView>

                    <!-- Play Button (no GlassView) -->
                    <ImageView
                        android:id="@+id/btn_play"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="12dp"
                        android:padding="18dp"
                        android:src="@drawable/play"
                        android:tint="#000000"
                        android:background="@drawable/circle_green"
                        android:scaleType="fitCenter" />

                    <!-- Share with GlassView -->
                    <dev.ui.obscura.blur.GlassView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_glass_halo"
                        android:elevation="6dp"
                        android:padding="4dp"
                        app:obscura_blurRadius="28"
                        app:obscura_cornerRadius="360dp"
                        app:obscura_opacity="0.65"
                        app:obscura_overlayColor="#12FFFFFF">

                        <ImageView
                            android:id="@+id/btn_share"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:src="@drawable/share"
                            android:tint="#FFFFFF"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                    </dev.ui.obscura.blur.GlassView>

                    <!-- More Options with GlassView -->
                    <dev.ui.obscura.blur.GlassView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_glass_halo"
                        android:elevation="6dp"
                        android:padding="4dp"
                        app:obscura_blurRadius="28"
                        app:obscura_cornerRadius="360dp"
                        app:obscura_opacity="0.65"
                        app:obscura_overlayColor="#12FFFFFF">

                        <ImageView
                            android:id="@+id/btn_more"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:src="@drawable/more"
                            android:tint="#FFFFFF"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                    </dev.ui.obscura.blur.GlassView>

                </LinearLayout>

            </LinearLayout>

            <!-- Songs RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_songs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="100dp"
                android:clipToPadding="false"
                tools:itemCount="20"
                tools:listitem="@layout/item_song" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
